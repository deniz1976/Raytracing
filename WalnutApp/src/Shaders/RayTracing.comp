#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D u_OutputImage;
layout(set = 0, binding = 1, rgba32f) uniform image2D u_AccumulationImage;

struct SphereData
{
	vec4 CenterRadius;
	vec4 AlbedoReflectivity;
	// x is roughness, y is material type and z is index of refraction.
	vec4 RoughnessMaterial;
};

layout(std430, set = 0, binding = 2) readonly buffer SphereBuffer
{
	SphereData Spheres[];
} u_SphereBuffer;

// Links.x is the left child of an interior node or the first sphere of a leaf,
// Links.y is the right child, Links.z is the sphere count and Links.w is the axis
// the range was split along. A count of zero marks an interior node.
//
// The build guarantees the left child holds the spheres with the smaller
// coordinate along that axis, which is what lets the traversal below work out
// which child is the near one from the sign of the ray direction alone.
struct BvhNodeData
{
	vec4 BoundsMin;
	vec4 BoundsMax;
	uvec4 Links;
};

layout(std430, set = 0, binding = 3) readonly buffer BvhBuffer
{
	BvhNodeData Nodes[];
} u_BvhBuffer;

// Position and intensity share a vec4 because std430 pads a lone vec3 out to 16
// bytes anyway, so the packing costs nothing and keeps the stride at 48 bytes.
struct AreaLightData
{
	vec4 PositionIntensity;
	vec4 Color;
	vec4 SizePadding;
};

layout(std430, set = 0, binding = 4) readonly buffer LightBuffer
{
	AreaLightData Lights[];
} u_LightBuffer;

layout(push_constant) uniform PushConstants
{
	vec4 CameraPosition;
	vec4 CameraForward;
	uint FrameIndex;
	float VerticalFov;
	float Exposure;
	uint SphereCount;
	uvec4 SceneSettings;
} u_PushConstants;

const int MAX_BOUNCES = 3;
const float RAY_EPSILON = 0.001;
const uint MATERIAL_LEGACY = 0u;
const uint MATERIAL_DIFFUSE = 1u;
const uint MATERIAL_METAL = 2u;
const uint MATERIAL_DIELECTRIC = 3u;

// A stack entry is only worth pushing if the far child can still turn out to be
// worth visiting, so both children go on and the near one comes off first. The
// build bounds the tree depth to well under this, and pushes stay guarded.
const int BVH_STACK_SIZE = 32;

struct Ray
{
	vec3 Origin;
	vec3 Direction;
};

struct Material
{
	vec3 Albedo;
	float Reflectivity;
	float Roughness;
	uint Type;
	float IndexOfRefraction;
};

struct AreaLight
{
	vec3 Position;
	vec3 Color;
	vec2 Size;
	float Intensity;
};

struct HitRecord
{
	float Distance;
	vec3 Position;
	vec3 Normal;
	bool FrontFace;
	Material SurfaceMaterial;
};

uint Hash(uint value)
{
	value ^= value >> 16;
	value *= 0x7feb352du;
	value ^= value >> 15;
	value *= 0x846ca68bu;
	value ^= value >> 16;
	return value;
}

float RandomFloat(uint seed)
{
	return float(Hash(seed)) / 4294967295.0;
}

float NextRandom(inout uint state)
{
	state = Hash(state);
	return float(state) / 4294967295.0;
}

// Schlick's approximation turns the view angle and optical density into the
// probability that glass reflects instead of refracts. It is cheap enough for a
// ray tracer while reproducing the strong reflections seen at grazing angles.
float SchlickReflectance(float cosine, float indexOfRefraction)
{
	float r0 =
		(1.0 - indexOfRefraction) /
		(1.0 + indexOfRefraction);
	r0 *= r0;
	return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

vec3 RandomUnitVector(inout uint state)
{
	float z = NextRandom(state) * 2.0 - 1.0;
	float angle = NextRandom(state) * 2.0 * 3.14159265359;
	float radius = sqrt(max(0.0, 1.0 - z * z));

	return vec3(
		radius * cos(angle),
		radius * sin(angle),
		z);
}

Material GetSphereMaterial(SphereData sphere)
{
	Material material;
	material.Albedo = sphere.AlbedoReflectivity.xyz;
	material.Reflectivity = sphere.AlbedoReflectivity.w;
	material.Roughness = sphere.RoughnessMaterial.x;
	material.Type = uint(sphere.RoughnessMaterial.y);
	material.IndexOfRefraction = sphere.RoughnessMaterial.z;
	return material;
}

float HitSphere(Ray ray, SphereData sphere)
{
	vec3 sphereCenter = sphere.CenterRadius.xyz;
	float sphereRadius = sphere.CenterRadius.w;
	vec3 originToCenter = ray.Origin - sphereCenter;

	float a = dot(ray.Direction, ray.Direction);
	float b = 2.0 * dot(originToCenter, ray.Direction);
	float c =
		dot(originToCenter, originToCenter) -
		sphereRadius * sphereRadius;

	float discriminant = b * b - 4.0 * a * c;
	if (discriminant < 0.0)
		return -1.0;

	float squareRoot = sqrt(discriminant);
	float nearestDistance = (-b - squareRoot) / (2.0 * a);
	if (nearestDistance > RAY_EPSILON)
		return nearestDistance;

	float farthestDistance = (-b + squareRoot) / (2.0 * a);
	if (farthestDistance > RAY_EPSILON)
		return farthestDistance;

	return -1.0;
}

// A zero direction component would turn into an infinite reciprocal, and the
// infinity multiplied by a zero distance would produce a NaN that breaks the
// comparisons below. Clamping to a large finite number avoids that entirely.
vec3 SafeInverseDirection(vec3 direction)
{
	const float largeValue = 1e30;
	vec3 inverseDirection;

	for (int axis = 0; axis < 3; axis++)
	{
		inverseDirection[axis] = abs(direction[axis]) > 1e-8
			? 1.0 / direction[axis]
			: (direction[axis] < 0.0 ? -largeValue : largeValue);
	}

	return inverseDirection;
}

// Slab test. Each axis gives the distance range in which the ray is inside that
// pair of parallel planes. The ray touches the box when the three ranges
// overlap, so the largest entry distance must not exceed the smallest exit
// distance. maximumDistance discards boxes that are farther than the closest
// surface found so far.
bool HitAabb(
	vec3 rayOrigin,
	vec3 inverseDirection,
	vec3 boundsMin,
	vec3 boundsMax,
	float maximumDistance)
{
	vec3 firstPlane = (boundsMin - rayOrigin) * inverseDirection;
	vec3 secondPlane = (boundsMax - rayOrigin) * inverseDirection;

	vec3 nearPlanes = min(firstPlane, secondPlane);
	vec3 farPlanes = max(firstPlane, secondPlane);

	float entryDistance = max(
		max(nearPlanes.x, nearPlanes.y),
		max(nearPlanes.z, 0.0));
	float exitDistance = min(
		min(farPlanes.x, farPlanes.y),
		farPlanes.z);

	return entryDistance <= exitDistance && entryDistance < maximumDistance;
}

// Tests one contiguous run of the sphere buffer and keeps the nearest hit. The
// spheres are uploaded in tree order, so a leaf owns such a run.
bool IntersectSphereRange(
	Ray ray,
	uint firstSphere,
	uint sphereCount,
	inout HitRecord closestHit)
{
	bool hitAnything = false;

	for (uint offset = 0; offset < sphereCount; offset++)
	{
		SphereData sphere = u_SphereBuffer.Spheres[firstSphere + offset];
		float hitDistance = HitSphere(ray, sphere);

		if (hitDistance > 0.0 && hitDistance < closestHit.Distance)
		{
			hitAnything = true;
			closestHit.Distance = hitDistance;
			closestHit.Position = ray.Origin + ray.Direction * hitDistance;
			vec3 outwardNormal = normalize(
				closestHit.Position - sphere.CenterRadius.xyz);
			closestHit.FrontFace = dot(ray.Direction, outwardNormal) < 0.0;
			closestHit.Normal = closestHit.FrontFace
				? outwardNormal
				: -outwardNormal;
			closestHit.SurfaceMaterial = GetSphereMaterial(sphere);
		}
	}

	return hitAnything;
}

bool TraceScene(
	Ray ray,
	out HitRecord closestHit)
{
	closestHit.Distance = 1e30;

	if (u_PushConstants.SceneSettings.x == 0u)
	{
		return IntersectSphereRange(
			ray,
			0u,
			u_PushConstants.SphereCount,
			closestHit);
	}

	bool hitAnything = false;
	vec3 inverseDirection = SafeInverseDirection(ray.Direction);

	uint nodeStack[BVH_STACK_SIZE];
	int stackSize = 0;
	nodeStack[stackSize++] = 0u;

	while (stackSize > 0)
	{
		BvhNodeData node = u_BvhBuffer.Nodes[nodeStack[--stackSize]];

		if (!HitAabb(
			ray.Origin,
			inverseDirection,
			node.BoundsMin.xyz,
			node.BoundsMax.xyz,
			closestHit.Distance))
		{
			continue;
		}

		if (node.Links.z > 0u)
		{
			if (IntersectSphereRange(
				ray,
				node.Links.x,
				node.Links.z,
				closestHit))
			{
				hitAnything = true;
			}
			continue;
		}

		if (stackSize + 2 <= BVH_STACK_SIZE)
		{
			// The left child holds the smaller coordinates along the split axis, so
			// a ray travelling in the positive direction on that axis reaches it
			// first. Visiting the near child first is what makes the pruning above
			// pay off: any surface found in it shrinks closestHit.Distance before
			// the far box is ever tested, and a far box behind that surface is then
			// rejected outright. Popping happens in reverse, so the far child is
			// the one pushed first.
			int splitAxis = int(node.Links.w);
			bool leftIsNear = ray.Direction[splitAxis] >= 0.0;

			nodeStack[stackSize++] = leftIsNear ? node.Links.y : node.Links.x;
			nodeStack[stackSize++] = leftIsNear ? node.Links.x : node.Links.y;
		}
	}

	return hitAnything;
}

bool IsOccluded(
	vec3 surfacePosition,
	vec3 surfaceNormal,
	vec3 directionToLight,
	float maximumDistance)
{
	Ray shadowRay;
	shadowRay.Origin = surfacePosition + surfaceNormal * RAY_EPSILON;
	shadowRay.Direction = directionToLight;

	if (u_PushConstants.SceneSettings.x == 0u)
	{
		for (uint sphereIndex = 0; sphereIndex < u_PushConstants.SphereCount; sphereIndex++)
		{
			float hitDistance = HitSphere(
				shadowRay,
				u_SphereBuffer.Spheres[sphereIndex]);
			if (hitDistance > 0.0 &&
				hitDistance < maximumDistance - RAY_EPSILON)
				return true;
		}

		return false;
	}

	vec3 inverseDirection = SafeInverseDirection(shadowRay.Direction);

	uint nodeStack[BVH_STACK_SIZE];
	int stackSize = 0;
	nodeStack[stackSize++] = 0u;

	while (stackSize > 0)
	{
		BvhNodeData node = u_BvhBuffer.Nodes[nodeStack[--stackSize]];

		if (!HitAabb(
			shadowRay.Origin,
			inverseDirection,
			node.BoundsMin.xyz,
			node.BoundsMax.xyz,
			maximumDistance))
		{
			continue;
		}

		if (node.Links.z > 0u)
		{
			// A shadow ray only needs to know whether anything blocks it, so the
			// first hit ends the search instead of looking for the nearest one.
			for (uint offset = 0; offset < node.Links.z; offset++)
			{
				float hitDistance = HitSphere(
					shadowRay,
					u_SphereBuffer.Spheres[node.Links.x + offset]);
				if (hitDistance > 0.0 &&
					hitDistance < maximumDistance - RAY_EPSILON)
					return true;
			}
			continue;
		}

		if (stackSize + 2 <= BVH_STACK_SIZE)
		{
			// Deliberately not ordered near to far the way TraceScene is. That
			// ordering pays off by shrinking the distance the box test prunes
			// against, and a shadow ray has no such distance: its limit is fixed at
			// the light and any blocker at all ends the search. So the sort would
			// cost work per node and buy nothing back.
			nodeStack[stackSize++] = node.Links.y;
			nodeStack[stackSize++] = node.Links.x;
		}
	}

	return false;
}

AreaLight GetAreaLight(uint lightIndex)
{
	AreaLightData data = u_LightBuffer.Lights[lightIndex];

	AreaLight light;
	light.Position = data.PositionIntensity.xyz;
	light.Intensity = data.PositionIntensity.w;
	light.Color = data.Color.xyz;
	light.Size = data.SizePadding.xy;
	return light;
}

// The ambient term stands in for light that never arrives directly, so it is a
// property of the surface and is added exactly once. Adding it inside the light
// loop would make the scene brighter with every light that is created.
vec3 CalculateAmbientLight(Material material)
{
	return material.Albedo * 0.08;
}

vec3 CalculateAreaLight(
	AreaLight light,
	Material material,
	vec3 surfaceNormal,
	vec3 directionToLight,
	float lightDistance,
	float lightVisibility)
{
	float diffuseStrength =
		max(dot(surfaceNormal, directionToLight), 0.0) *
		lightVisibility;
	float attenuation =
		light.Intensity /
		max(lightDistance * lightDistance, 0.01);

	return
		material.Albedo *
		light.Color *
		diffuseStrength *
		attenuation;
}

// Picks one light in proportion to the slice of the total weight it was given on
// the CPU, and reports the probability of that pick so the caller can divide the
// contribution by it. Returns false only when no light carries any weight, which
// means every one of them would have contributed exactly zero.
//
// The slices are scanned in order rather than binary searched because the light
// count is capped at eight; the bounds are stored as a running total precisely so
// that a search can replace this loop once the cap grows.
bool SelectAreaLight(
	uint lightCount,
	inout uint randomState,
	out uint selectedLight,
	out float selectionProbability)
{
	float random = NextRandom(randomState);

	selectedLight = lightCount;
	selectionProbability = 0.0;

	for (uint lightIndex = 0u; lightIndex < lightCount; lightIndex++)
	{
		float probability = u_LightBuffer.Lights[lightIndex].SizePadding.w;

		// A zero slice belongs to a light that cannot contribute at all, and its
		// bound repeats the previous one, so skipping it changes no other pick.
		if (probability <= 0.0)
			continue;

		// Remembered on every candidate so that a random value of exactly one,
		// which no bound is strictly greater than, still ends up on a light with a
		// probability that can be divided by instead of dropping the sample.
		selectedLight = lightIndex;
		selectionProbability = probability;

		if (random < u_LightBuffer.Lights[lightIndex].SizePadding.z)
			return true;
	}

	return selectedLight < lightCount;
}

// Spends one shadow ray on a random point of one light and returns the direct
// contribution of that light alone. Both the all-lights loop and the stochastic
// single-light path call this, so they differ only in how many times it runs and
// how the result is weighted.
vec3 SampleAreaLight(
	uint lightIndex,
	HitRecord hit,
	inout uint randomState)
{
	AreaLight light = GetAreaLight(lightIndex);

	vec2 lightOffset =
		(vec2(
			NextRandom(randomState),
			NextRandom(randomState)) - 0.5) *
		light.Size;
	vec3 sampledLightPosition =
		light.Position +
		vec3(lightOffset.x, 0.0, lightOffset.y);

	vec3 surfaceToLight = sampledLightPosition - hit.Position;
	float lightDistance = length(surfaceToLight);

	// A light sampled exactly on the surface would divide by zero and poison the
	// running sum with a NaN.
	if (lightDistance < RAY_EPSILON)
		return vec3(0.0);

	vec3 directionToLight = surfaceToLight / lightDistance;

	bool isInShadow = IsOccluded(
		hit.Position,
		hit.Normal,
		directionToLight,
		lightDistance);

	float lightVisibility = isInShadow ? 0.0 : 1.0;
	return CalculateAreaLight(
		light,
		hit.SurfaceMaterial,
		hit.Normal,
		directionToLight,
		lightDistance,
		lightVisibility);
}

vec3 GetSkyColor(vec3 rayDirection)
{
	float skyBlend = 0.5 * (rayDirection.y + 1.0);
	vec3 horizonColor = vec3(1.0);
	vec3 skyColor = vec3(0.5, 0.7, 1.0);
	return mix(horizonColor, skyColor, skyBlend);
}

vec3 ToneMapReinhard(vec3 hdrColor)
{
	return hdrColor / (vec3(1.0) + hdrColor);
}

vec3 ApplyGammaCorrection(vec3 linearColor)
{
	return pow(max(linearColor, vec3(0.0)), vec3(1.0 / 2.2));
}

vec3 TraceRay(
	Ray initialRay,
	uint randomSeed)
{
	Ray ray = initialRay;
	vec3 accumulatedColor = vec3(0.0);
	vec3 throughput = vec3(1.0);
	uint randomState = randomSeed;
	uint lightCount = u_PushConstants.SceneSettings.y;
	bool sampleOneLight = u_PushConstants.SceneSettings.z != 0u;

	for (int bounceIndex = 0; bounceIndex < MAX_BOUNCES; bounceIndex++)
	{
		HitRecord closestHit;

		if (!TraceScene(ray, closestHit))
		{
			accumulatedColor += throughput * GetSkyColor(ray.Direction);
			break;
		}

		Material material = closestHit.SurfaceMaterial;
		bool usesDiffuseLighting =
			material.Type == MATERIAL_LEGACY ||
			material.Type == MATERIAL_DIFFUSE;
		vec3 surfaceColor = vec3(0.0);

		if (usesDiffuseLighting)
		{
			surfaceColor = CalculateAmbientLight(material);

			if (sampleOneLight && lightCount > 0u)
			{
				// One chosen light stands in for the whole list, so the shadow ray
				// cost per bounce no longer grows with light count. Dividing by the
				// probability keeps the expected value equal to the full light sum.
				uint lightIndex;
				float selectionProbability;
				if (SelectAreaLight(
					lightCount,
					randomState,
					lightIndex,
					selectionProbability))
				{
					surfaceColor +=
						SampleAreaLight(lightIndex, closestHit, randomState) /
						selectionProbability;
				}
			}
			else
			{
				// Every light is sampled independently and its contribution is
				// summed, so light count multiplies the shadow ray cost per bounce.
				for (uint lightIndex = 0; lightIndex < lightCount; lightIndex++)
				{
					surfaceColor += SampleAreaLight(
						lightIndex,
						closestHit,
						randomState);
				}
			}
		}

		if (material.Type == MATERIAL_DIFFUSE)
		{
			// Diffuse is intentionally the simplest material: direct and ambient
			// light are its final answer, so it does not spend another bounce.
			accumulatedColor += throughput * surfaceColor;
			break;
		}

		if (material.Type == MATERIAL_DIELECTRIC)
		{
			// Entering glass goes from air (1.0) to the material IOR; leaving it
			// reverses that ratio. The oriented normal always opposes the ray.
			float refractionRatio = closestHit.FrontFace
				? 1.0 / material.IndexOfRefraction
				: material.IndexOfRefraction;
			vec3 unitDirection = normalize(ray.Direction);
			float cosTheta = min(dot(-unitDirection, closestHit.Normal), 1.0);
			float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

			// When Snell's law has no real solution, all energy must reflect. In
			// every other case Schlick chooses between reflection and refraction.
			bool cannotRefract = refractionRatio * sinTheta > 1.0;
			float reflectionProbability = SchlickReflectance(
				cosTheta,
				material.IndexOfRefraction);
			bool shouldReflect =
				cannotRefract ||
				reflectionProbability > NextRandom(randomState);

			ray.Direction = shouldReflect
				? normalize(reflect(unitDirection, closestHit.Normal))
				: normalize(refract(
					unitDirection,
					closestHit.Normal,
					refractionRatio));
			// This small model uses albedo as a transmission tint. Offsetting along
			// the new direction puts an entering ray inside and an exiting ray outside.
			throughput *= material.Albedo;
			ray.Origin = closestHit.Position + ray.Direction * RAY_EPSILON;
			continue;
		}

		float reflectivity = material.Reflectivity;
		if (material.Type == MATERIAL_LEGACY)
		{
			// Old scene files keep the original hybrid model exactly: part of the
			// energy uses diffuse lighting and the rest continues as a reflection.
			accumulatedColor +=
				throughput * surfaceColor * (1.0 - reflectivity);
		}

		if (reflectivity <= 0.0)
			break;

		// Metal has no Lambert term in this small model. Its albedo tints the
		// reflected light, while reflection strength controls how much survives.
		throughput *= material.Albedo * reflectivity;

		ray.Origin =
			closestHit.Position +
			closestHit.Normal * RAY_EPSILON;

		vec3 perfectReflection = normalize(reflect(
			ray.Direction,
			closestHit.Normal));

		vec3 randomDirection = RandomUnitVector(randomState);
		if (dot(randomDirection, closestHit.Normal) < 0.0)
			randomDirection = -randomDirection;

		float roughness = material.Roughness;
		ray.Direction = normalize(mix(
			perfectReflection,
			randomDirection,
			roughness));
	}

	return accumulatedColor;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 imageSize = imageSize(u_OutputImage);

	if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
		return;

	uint pixelSeed =
		uint(pixel.x) +
		uint(pixel.y) * uint(imageSize.x);
	uint frameSeed = pixelSeed ^ (u_PushConstants.FrameIndex * 0x9e3779b9u);
	vec2 pixelJitter = vec2(
		RandomFloat(frameSeed),
		RandomFloat(frameSeed ^ 0x68bc21ebu)) - 0.5;

	vec2 uv =
		(vec2(pixel) + vec2(0.5) + pixelJitter) /
		vec2(imageSize);
	vec2 screenPosition = uv * 2.0 - 1.0;
	// Image rows grow downwards while world up is +Y, so this is the single
	// place the two conventions are reconciled: row 0 becomes the top of the
	// scene. The display path must not flip the image again.
	screenPosition.y = -screenPosition.y;

	float aspectRatio = float(imageSize.x) / float(imageSize.y);
	float fieldOfView = radians(u_PushConstants.VerticalFov);
	float fieldOfViewScale = tan(fieldOfView * 0.5);

	vec3 cameraForward = normalize(u_PushConstants.CameraForward.xyz);
	vec3 worldUp = vec3(0.0, 1.0, 0.0);
	vec3 cameraRight = normalize(cross(cameraForward, worldUp));
	vec3 cameraUp = normalize(cross(cameraRight, cameraForward));

	Ray ray;
	ray.Origin = u_PushConstants.CameraPosition.xyz;
	ray.Direction = normalize(
		cameraForward +
		cameraRight *
			screenPosition.x *
			aspectRatio *
			fieldOfViewScale +
		cameraUp *
			screenPosition.y *
			fieldOfViewScale);

	uint pathSeed = frameSeed ^ 0xa511e9b3u;
	vec3 sampleColor = TraceRay(ray, pathSeed);
	vec3 previousAccumulation =
		u_PushConstants.FrameIndex > 1
			? imageLoad(u_AccumulationImage, pixel).rgb
			: vec3(0.0);

	vec3 accumulatedColor = previousAccumulation + sampleColor;
	imageStore(
		u_AccumulationImage,
		pixel,
		vec4(accumulatedColor, 1.0));

	vec3 averageColor =
		accumulatedColor /
		float(u_PushConstants.FrameIndex);

	vec3 exposedColor = averageColor * u_PushConstants.Exposure;
	vec3 toneMappedColor = ToneMapReinhard(exposedColor);
	vec3 displayColor = ApplyGammaCorrection(toneMappedColor);
	imageStore(u_OutputImage, pixel, vec4(displayColor, 1.0));
}
