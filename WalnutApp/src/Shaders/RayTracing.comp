#version 460
#extension GL_GOOGLE_include_directive : require

// Compiled twice: with USE_RAY_QUERY for devices that support VK_KHR_ray_query,
// and without it as a fallback that always traverses the custom triangle BVH.
#ifdef USE_RAY_QUERY
#extension GL_EXT_ray_query : require
#endif

#include "ShaderInterface.h"

layout(local_size_x = WORKGROUP_SIZE, local_size_y = WORKGROUP_SIZE, local_size_z = 1) in;

layout(set = 0, binding = BINDING_OUTPUT_IMAGE, rgba8) uniform writeonly image2D u_OutputImage;
layout(set = 0, binding = BINDING_ACCUMULATION_IMAGE, rgba32f) uniform image2D u_AccumulationImage;

struct SphereData
{
	vec4 CenterRadius;
	vec4 AlbedoReflectivity;
	// x is roughness, y is material type and z is index of refraction.
	vec4 RoughnessMaterial;
};

layout(std430, set = 0, binding = BINDING_SPHERES) readonly buffer SphereBuffer
{
	SphereData Spheres[];
} u_SphereBuffer;

// Links.x is the left child of an interior node or the first primitive of a leaf,
// Links.y is the right child, Links.z is the primitive count and Links.w is the
// axis the range was split along. A count of zero marks an interior node.
//
// The build guarantees the left child holds the primitives with the smaller
// centroid along that axis, which is what lets the traversal below work out
// which child is the near one from the sign of the ray direction alone.
struct BvhNodeData
{
	vec4 BoundsMin;
	vec4 BoundsMax;
	uvec4 Links;
};

layout(std430, set = 0, binding = BINDING_SPHERE_BVH) readonly buffer BvhBuffer
{
	BvhNodeData Nodes[];
} u_BvhBuffer;

// Position and intensity share a vec4 because std430 pads a lone vec3 out to 16
// bytes anyway, so the packing costs nothing and keeps the stride at 48 bytes.
struct SphereLightData
{
	vec4 PositionIntensity;
	vec4 Color;
	// x is radius, z is the selection CDF and w is its probability.
	vec4 RadiusSampling;
};

layout(std430, set = 0, binding = BINDING_LIGHTS) readonly buffer LightBuffer
{
	SphereLightData Lights[];
} u_LightBuffer;

// Triangles are stored in the model's own space. The model transform is applied
// to the ray instead, so moving the model never rebuilds this buffer or its BVH.
struct TriangleData
{
	vec4 Vertex0;
	vec4 Vertex1;
	vec4 Vertex2;
	vec4 AlbedoReflectivity;
	vec4 RoughnessMaterial;
	// Normal0.w is one when the OBJ supplied all three corner normals.
	vec4 Normal0;
	vec4 Normal1;
	vec4 Normal2;
	vec4 TexCoord01;
	// TexCoord2.z is one when an image texture is sampled and w is one when all
	// three corners have UV coordinates.
	vec4 TexCoord2;
};

layout(std430, set = 0, binding = BINDING_TRIANGLES) readonly buffer TriangleBuffer
{
	TriangleData Triangles[];
} u_TriangleBuffer;

layout(std430, set = 0, binding = BINDING_TRIANGLE_BVH) readonly buffer TriangleBvhBuffer
{
	BvhNodeData Nodes[];
} u_TriangleBvhBuffer;

layout(set = 0, binding = BINDING_MODEL_TEXTURE) uniform sampler2D u_ModelTexture;
layout(set = 0, binding = BINDING_ENVIRONMENT_TEXTURE) uniform sampler2D u_EnvironmentTexture;

layout(std430, set = 0, binding = BINDING_ENVIRONMENT_DISTRIBUTION) readonly buffer EnvironmentDistributionBuffer
{
	// x is the running CDF, y the probability of that texel.
	vec4 Entries[];
} u_EnvironmentDistribution;

layout(std430, set = 0, binding = BINDING_MODEL_TRANSFORM) readonly buffer ModelTransformBuffer
{
	mat4 WorldToObject;
} u_Model;

#ifdef USE_RAY_QUERY
layout(set = 0, binding = BINDING_TRIANGLE_TLAS) uniform accelerationStructureEXT u_TriangleTlas;
#endif

layout(push_constant) uniform PushConstants
{
	vec4 CameraPosition;
	vec4 CameraForward;
	uint FrameIndex;
	float VerticalFov;
	float Exposure;
	uint SphereCount;
	uint TriangleCount;
	uint LightCount;
	uint BounceCount;
	uint Flags;
	float EnvironmentIntensity;
	float EnvironmentRotation;
	uint EnvironmentWidth;
	uint EnvironmentHeight;
} u_PushConstants;

const float RAY_EPSILON = 0.001;
const float PI = 3.14159265359;
const float NO_HIT = 1e30;
// Let the first few path segments run deterministically, then spend fewer rays
// on weak paths without changing their expected contribution.
const uint RUSSIAN_ROULETTE_START_BOUNCE = 3u;
const float MIN_PATH_SURVIVAL_PROBABILITY = 0.05;
const float MAX_PATH_SURVIVAL_PROBABILITY = 0.95;

const uint HIT_NONE = 0u;
const uint HIT_SPHERE = 1u;
const uint HIT_TRIANGLE = 2u;

struct Ray
{
	vec3 Origin;
	vec3 Direction;
};

struct Material
{
	vec3 Albedo;
	float Reflectivity;
	float Roughness;
	uint Type;
	float IndexOfRefraction;
};

struct SphereLight
{
	vec3 Position;
	vec3 Color;
	float Radius;
	float Intensity;
};

// The cheap part of a hit, found during traversal. Surface details are only
// worked out once, for the closest hit, instead of for every candidate.
struct SceneHit
{
	float Distance;
	uint Kind;
	uint Index;
	vec2 Barycentrics;
};

struct HitRecord
{
	float Distance;
	vec3 Position;
	vec3 Normal;
	bool FrontFace;
	Material SurfaceMaterial;
};

bool HasFlag(uint flag)
{
	return (u_PushConstants.Flags & flag) != 0u;
}

uint Hash(uint value)
{
	value ^= value >> 16;
	value *= 0x7feb352du;
	value ^= value >> 15;
	value *= 0x846ca68bu;
	value ^= value >> 16;
	return value;
}

// The top 24 bits fill a float mantissa exactly, so the result is uniform in
// [0, 1) and can never round up to one.
float UintToUnitFloat(uint value)
{
	return float(value >> 8) * (1.0 / 16777216.0);
}

float RandomFloat(uint seed)
{
	return UintToUnitFloat(Hash(seed));
}

float NextRandom(inout uint state)
{
	state = Hash(state);
	return UintToUnitFloat(state);
}

// Schlick's approximation turns the view angle and optical density into the
// probability that glass reflects instead of refracts. It is cheap enough for a
// ray tracer while reproducing the strong reflections seen at grazing angles.
float SchlickReflectance(float cosine, float indexOfRefraction)
{
	float r0 =
		(1.0 - indexOfRefraction) /
		(1.0 + indexOfRefraction);
	r0 *= r0;
	return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

vec3 RandomUnitVector(inout uint state)
{
	float z = NextRandom(state) * 2.0 - 1.0;
	float angle = NextRandom(state) * 2.0 * PI;
	float radius = sqrt(max(0.0, 1.0 - z * z));

	return vec3(
		radius * cos(angle),
		radius * sin(angle),
		z);
}

vec3 LocalToWorld(vec3 localDirection, vec3 normal)
{
	vec3 helperAxis = abs(normal.z) < 0.999
		? vec3(0.0, 0.0, 1.0)
		: vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(helperAxis, normal));
	vec3 bitangent = cross(normal, tangent);

	return normalize(
		tangent * localDirection.x +
		bitangent * localDirection.y +
		normal * localDirection.z);
}

// A Lambert surface scatters most strongly near its normal. Sampling that
// cosine distribution follows the integrand and keeps the estimator's variance
// lower than choosing every hemisphere direction equally often.
vec3 RandomCosineHemisphere(vec3 normal, inout uint state)
{
	float firstRandom = NextRandom(state);
	float secondRandom = NextRandom(state);
	float angle = 2.0 * PI * firstRandom;
	float radialDistance = sqrt(secondRandom);

	vec3 localDirection = vec3(
		cos(angle) * radialDistance,
		sin(angle) * radialDistance,
		sqrt(max(0.0, 1.0 - secondRandom)));

	return LocalToWorld(localDirection, normal);
}

vec3 EvaluateLambertBrdf(Material material)
{
	return material.Albedo / PI;
}

float LambertPdf(vec3 surfaceNormal, vec3 sampledDirection)
{
	return max(dot(surfaceNormal, sampledDirection), 0.0) / PI;
}

vec3 FresnelSchlick(float cosine, vec3 reflectanceAtNormalIncidence)
{
	return reflectanceAtNormalIncidence +
		(vec3(1.0) - reflectanceAtNormalIncidence) *
		pow(1.0 - cosine, 5.0);
}

float GgxDistribution(float normalDotHalfway, float alpha)
{
	float alphaSquared = alpha * alpha;
	float denominator =
		normalDotHalfway * normalDotHalfway *
		(alphaSquared - 1.0) + 1.0;
	return alphaSquared /
		max(PI * denominator * denominator, 1e-8);
}

float SmithGgxMasking(float normalDotDirection, float alpha)
{
	float alphaSquared = alpha * alpha;
	float root = sqrt(
		alphaSquared +
		(1.0 - alphaSquared) *
		normalDotDirection * normalDotDirection);
	return
		2.0 * normalDotDirection /
		max(normalDotDirection + root, 1e-8);
}

float GgxAlpha(Material material)
{
	return max(material.Roughness * material.Roughness, 0.001);
}

vec3 EvaluateMetalBrdf(
	Material material,
	vec3 surfaceNormal,
	vec3 viewDirection,
	vec3 lightDirection)
{
	float normalDotView = max(dot(surfaceNormal, viewDirection), 0.0);
	float normalDotLight = max(dot(surfaceNormal, lightDirection), 0.0);
	if (normalDotView <= 0.0 || normalDotLight <= 0.0)
		return vec3(0.0);

	vec3 halfwaySum = viewDirection + lightDirection;
	if (dot(halfwaySum, halfwaySum) <= 1e-12)
		return vec3(0.0);

	vec3 halfwayDirection = normalize(halfwaySum);
	float normalDotHalfway = max(dot(surfaceNormal, halfwayDirection), 0.0);
	float viewDotHalfway = max(dot(viewDirection, halfwayDirection), 0.0);
	float alpha = GgxAlpha(material);

	vec3 fresnel =
		FresnelSchlick(viewDotHalfway, material.Albedo) *
		material.Reflectivity;
	float distribution = GgxDistribution(normalDotHalfway, alpha);
	float geometry =
		SmithGgxMasking(normalDotView, alpha) *
		SmithGgxMasking(normalDotLight, alpha);

	return
		fresnel * distribution * geometry /
		max(4.0 * normalDotView * normalDotLight, 1e-8);
}

float MetalReflectionPdf(
	Material material,
	vec3 surfaceNormal,
	vec3 viewDirection,
	vec3 reflectedDirection)
{
	vec3 halfwaySum = viewDirection + reflectedDirection;
	if (dot(halfwaySum, halfwaySum) <= 1e-12)
		return 0.0;

	vec3 halfwayDirection = normalize(halfwaySum);
	float normalDotHalfway = max(dot(surfaceNormal, halfwayDirection), 0.0);
	float viewDotHalfway = max(dot(viewDirection, halfwayDirection), 0.0);
	if (normalDotHalfway <= 0.0 || viewDotHalfway <= 0.0)
		return 0.0;

	float halfwayPdf =
		GgxDistribution(normalDotHalfway, GgxAlpha(material)) *
		normalDotHalfway;
	return halfwayPdf / (4.0 * viewDotHalfway);
}

vec3 SampleGgxReflection(
	Material material,
	vec3 surfaceNormal,
	vec3 viewDirection,
	inout uint randomState)
{
	float alpha = GgxAlpha(material);
	float alphaSquared = alpha * alpha;
	float firstRandom = NextRandom(randomState);
	float secondRandom = NextRandom(randomState);
	float angle = 2.0 * PI * firstRandom;
	float cosTheta = sqrt(
		(1.0 - secondRandom) /
		max(1.0 + (alphaSquared - 1.0) * secondRandom, 1e-8));
	float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
	vec3 localHalfway = vec3(
		cos(angle) * sinTheta,
		sin(angle) * sinTheta,
		cosTheta);
	vec3 halfwayDirection = LocalToWorld(localHalfway, surfaceNormal);
	if (dot(viewDirection, halfwayDirection) < 0.0)
		halfwayDirection = -halfwayDirection;

	return normalize(reflect(-viewDirection, halfwayDirection));
}

// Legacy direct lighting uses the Lambert lobe too, which is why only Metal is
// special cased here.
vec3 EvaluateSurfaceBrdf(
	Material material,
	vec3 surfaceNormal,
	vec3 viewDirection,
	vec3 lightDirection)
{
	return material.Type == MATERIAL_METAL
		? EvaluateMetalBrdf(
			material,
			surfaceNormal,
			viewDirection,
			lightDirection)
		: EvaluateLambertBrdf(material);
}

// The density with which the path continuation would have picked this
// direction, used to weigh light samples against BSDF samples. Legacy surfaces
// never continue with a sample from the lobe they are lit with, so no BSDF
// strategy competes with their light samples and the density is zero; weighing
// them anyway would drop part of their direct light for nothing in return.
float SurfaceDirectionPdf(
	Material material,
	vec3 surfaceNormal,
	vec3 viewDirection,
	vec3 sampledDirection)
{
	if (material.Type == MATERIAL_LEGACY)
		return 0.0;

	return material.Type == MATERIAL_METAL
		? MetalReflectionPdf(
			material,
			surfaceNormal,
			viewDirection,
			sampledDirection)
		: LambertPdf(surfaceNormal, sampledDirection);
}

Material UnpackMaterial(vec4 albedoReflectivity, vec4 roughnessMaterial)
{
	Material material;
	material.Albedo = albedoReflectivity.xyz;
	material.Reflectivity = albedoReflectivity.w;
	material.Roughness = roughnessMaterial.x;
	material.Type = uint(roughnessMaterial.y);
	material.IndexOfRefraction = roughnessMaterial.z;
	return material;
}

// ---------------------------------------------------------------- geometry

float HitSphereGeometry(Ray ray, vec3 sphereCenter, float sphereRadius)
{
	vec3 originToCenter = ray.Origin - sphereCenter;

	float a = dot(ray.Direction, ray.Direction);
	float b = 2.0 * dot(originToCenter, ray.Direction);
	float c =
		dot(originToCenter, originToCenter) -
		sphereRadius * sphereRadius;

	float discriminant = b * b - 4.0 * a * c;
	if (discriminant < 0.0)
		return -1.0;

	float squareRoot = sqrt(discriminant);
	float nearestDistance = (-b - squareRoot) / (2.0 * a);
	if (nearestDistance > RAY_EPSILON)
		return nearestDistance;

	float farthestDistance = (-b + squareRoot) / (2.0 * a);
	if (farthestDistance > RAY_EPSILON)
		return farthestDistance;

	return -1.0;
}

// Moller-Trumbore expresses the hit in the triangle's two edge directions.
// The barycentric u/v checks reject points outside without constructing a plane.
// The ray may be in object space with an unnormalised direction; the returned
// distance is then still the world space ray parameter.
float HitTriangleGeometry(Ray ray, TriangleData triangle, out vec2 barycentrics)
{
	barycentrics = vec2(0.0);
	vec3 vertex0 = triangle.Vertex0.xyz;
	vec3 edge1 = triangle.Vertex1.xyz - vertex0;
	vec3 edge2 = triangle.Vertex2.xyz - vertex0;
	vec3 directionCrossEdge2 = cross(ray.Direction, edge2);
	float determinant = dot(edge1, directionCrossEdge2);
	if (abs(determinant) < 1e-12)
		return -1.0;

	float inverseDeterminant = 1.0 / determinant;
	vec3 vertex0ToOrigin = ray.Origin - vertex0;
	float barycentricU =
		dot(vertex0ToOrigin, directionCrossEdge2) * inverseDeterminant;
	if (barycentricU < 0.0 || barycentricU > 1.0)
		return -1.0;

	vec3 originCrossEdge1 = cross(vertex0ToOrigin, edge1);
	float barycentricV =
		dot(ray.Direction, originCrossEdge1) * inverseDeterminant;
	if (barycentricV < 0.0 || barycentricU + barycentricV > 1.0)
		return -1.0;

	float hitDistance = dot(edge2, originCrossEdge1) * inverseDeterminant;
	if (hitDistance <= RAY_EPSILON)
		return -1.0;

	barycentrics = vec2(barycentricU, barycentricV);
	return hitDistance;
}

Ray ToObjectSpace(Ray ray)
{
	Ray objectRay;
	objectRay.Origin = (u_Model.WorldToObject * vec4(ray.Origin, 1.0)).xyz;
	objectRay.Direction = mat3(u_Model.WorldToObject) * ray.Direction;
	return objectRay;
}

// A zero direction component would turn into an infinite reciprocal, and the
// infinity multiplied by a zero distance would produce a NaN that breaks the
// comparisons below. Clamping to a large finite number avoids that entirely.
vec3 SafeInverseDirection(vec3 direction)
{
	const float largeValue = 1e30;
	vec3 inverseDirection;

	for (int axis = 0; axis < 3; axis++)
	{
		inverseDirection[axis] = abs(direction[axis]) > 1e-8
			? 1.0 / direction[axis]
			: (direction[axis] < 0.0 ? -largeValue : largeValue);
	}

	return inverseDirection;
}

// Slab test. Each axis gives the distance range in which the ray is inside that
// pair of parallel planes. The ray touches the box when the three ranges
// overlap. maximumDistance discards boxes farther than the closest hit so far.
bool HitAabb(
	vec3 rayOrigin,
	vec3 inverseDirection,
	BvhNodeData node,
	float maximumDistance)
{
	vec3 firstPlane = (node.BoundsMin.xyz - rayOrigin) * inverseDirection;
	vec3 secondPlane = (node.BoundsMax.xyz - rayOrigin) * inverseDirection;

	vec3 nearPlanes = min(firstPlane, secondPlane);
	vec3 farPlanes = max(firstPlane, secondPlane);

	float entryDistance = max(
		max(nearPlanes.x, nearPlanes.y),
		max(nearPlanes.z, 0.0));
	float exitDistance = min(
		min(farPlanes.x, farPlanes.y),
		farPlanes.z);

	return entryDistance <= exitDistance && entryDistance < maximumDistance;
}

// Both children go on the stack and the near one comes off first, so a surface
// found early shrinks the distance the far box is pruned against. The build
// bounds the tree depth below the stack size, so the push guard at the call
// sites only keeps a broken tree from writing out of bounds.
void OrderChildren(
	BvhNodeData node,
	vec3 rayDirection,
	out uint pushedFirst,
	out uint pushedSecond)
{
	bool leftIsNear = rayDirection[node.Links.w] >= 0.0;
	pushedFirst = leftIsNear ? node.Links.y : node.Links.x;
	pushedSecond = leftIsNear ? node.Links.x : node.Links.y;
}

// Every intersection routine below keeps the nearest hit closer than
// hit.Distance. With anyHit set it returns at the first such hit instead, which
// is all a shadow ray needs to know.
bool IntersectSphereRange(
	Ray ray,
	uint firstSphere,
	uint sphereCount,
	bool anyHit,
	inout SceneHit hit)
{
	bool hitAnything = false;
	for (uint offset = 0u; offset < sphereCount; offset++)
	{
		SphereData sphere = u_SphereBuffer.Spheres[firstSphere + offset];
		float distance = HitSphereGeometry(
			ray,
			sphere.CenterRadius.xyz,
			sphere.CenterRadius.w);
		if (distance > 0.0 && distance < hit.Distance)
		{
			hit.Distance = distance;
			hit.Kind = HIT_SPHERE;
			hit.Index = firstSphere + offset;
			hitAnything = true;
			if (anyHit)
				return true;
		}
	}
	return hitAnything;
}

bool IntersectTriangleRange(
	Ray objectRay,
	uint firstTriangle,
	uint triangleCount,
	bool anyHit,
	inout SceneHit hit)
{
	bool hitAnything = false;
	for (uint offset = 0u; offset < triangleCount; offset++)
	{
		vec2 barycentrics;
		float distance = HitTriangleGeometry(
			objectRay,
			u_TriangleBuffer.Triangles[firstTriangle + offset],
			barycentrics);
		if (distance > 0.0 && distance < hit.Distance)
		{
			hit.Distance = distance;
			hit.Kind = HIT_TRIANGLE;
			hit.Index = firstTriangle + offset;
			hit.Barycentrics = barycentrics;
			hitAnything = true;
			if (anyHit)
				return true;
		}
	}
	return hitAnything;
}

bool TraceSpheres(Ray ray, bool anyHit, inout SceneHit hit)
{
	uint sphereCount = u_PushConstants.SphereCount;
	if (!HasFlag(RENDER_FLAG_USE_BVH))
		return IntersectSphereRange(ray, 0u, sphereCount, anyHit, hit);
	if (sphereCount == 0u)
		return false;

	bool hitAnything = false;
	vec3 inverseDirection = SafeInverseDirection(ray.Direction);
	uint nodeStack[BVH_STACK_SIZE];
	int stackSize = 0;
	nodeStack[stackSize++] = 0u;

	while (stackSize > 0)
	{
		BvhNodeData node = u_BvhBuffer.Nodes[nodeStack[--stackSize]];
		if (!HitAabb(ray.Origin, inverseDirection, node, hit.Distance))
			continue;

		if (node.Links.z == 0u)
		{
			if (stackSize + 2 <= BVH_STACK_SIZE)
			{
				uint farChild;
				uint nearChild;
				OrderChildren(node, ray.Direction, farChild, nearChild);
				nodeStack[stackSize++] = farChild;
				nodeStack[stackSize++] = nearChild;
			}
			continue;
		}

		if (IntersectSphereRange(ray, node.Links.x, node.Links.z, anyHit, hit))
		{
			hitAnything = true;
			if (anyHit)
				return true;
		}
	}

	return hitAnything;
}

bool TraceTriangleBvh(Ray ray, bool anyHit, inout SceneHit hit)
{
	Ray objectRay = ToObjectSpace(ray);
	if (!HasFlag(RENDER_FLAG_USE_BVH))
	{
		return IntersectTriangleRange(
			objectRay, 0u, u_PushConstants.TriangleCount, anyHit, hit);
	}

	bool hitAnything = false;
	vec3 inverseDirection = SafeInverseDirection(objectRay.Direction);
	uint nodeStack[BVH_STACK_SIZE];
	int stackSize = 0;
	nodeStack[stackSize++] = 0u;

	while (stackSize > 0)
	{
		BvhNodeData node = u_TriangleBvhBuffer.Nodes[nodeStack[--stackSize]];
		if (!HitAabb(objectRay.Origin, inverseDirection, node, hit.Distance))
			continue;

		if (node.Links.z == 0u)
		{
			if (stackSize + 2 <= BVH_STACK_SIZE)
			{
				uint farChild;
				uint nearChild;
				OrderChildren(node, objectRay.Direction, farChild, nearChild);
				nodeStack[stackSize++] = farChild;
				nodeStack[stackSize++] = nearChild;
			}
			continue;
		}

		if (IntersectTriangleRange(
			objectRay, node.Links.x, node.Links.z, anyHit, hit))
		{
			hitAnything = true;
			if (anyHit)
				return true;
		}
	}

	return hitAnything;
}

#ifdef USE_RAY_QUERY
// Hardware traversal of the same triangles. The TLAS instance carries the model
// transform and custom index zero, so the primitive index addresses the
// triangle buffer directly and the distance is the world space ray parameter.
bool TraceTrianglesRayQuery(Ray ray, bool anyHit, inout SceneHit hit)
{
	if (hit.Distance <= RAY_EPSILON)
		return false;

	uint rayFlags = gl_RayFlagsOpaqueEXT;
	if (anyHit)
		rayFlags |= gl_RayFlagsTerminateOnFirstHitEXT;

	rayQueryEXT query;
	rayQueryInitializeEXT(
		query,
		u_TriangleTlas,
		rayFlags,
		0xff,
		ray.Origin,
		RAY_EPSILON,
		ray.Direction,
		hit.Distance);
	while (rayQueryProceedEXT(query))
	{
	}
	if (rayQueryGetIntersectionTypeEXT(query, true) ==
		gl_RayQueryCommittedIntersectionNoneEXT)
	{
		return false;
	}

	hit.Distance = rayQueryGetIntersectionTEXT(query, true);
	hit.Kind = HIT_TRIANGLE;
	hit.Index =
		uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)) +
		uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
	hit.Barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
	return true;
}
#endif

bool TraceTriangles(Ray ray, bool anyHit, inout SceneHit hit)
{
	if (u_PushConstants.TriangleCount == 0u)
		return false;

#ifdef USE_RAY_QUERY
	if (HasFlag(RENDER_FLAG_RAY_QUERY))
		return TraceTrianglesRayQuery(ray, anyHit, hit);
#endif
	return TraceTriangleBvh(ray, anyHit, hit);
}

// ------------------------------------------------------------ hit shading

void EvaluateTriangleSurface(
	TriangleData triangle,
	vec2 barycentrics,
	vec3 objectRayDirection,
	out vec3 shadingNormal,
	out bool frontFace,
	out vec3 textureTint)
{
	vec3 edge1 = triangle.Vertex1.xyz - triangle.Vertex0.xyz;
	vec3 edge2 = triangle.Vertex2.xyz - triangle.Vertex0.xyz;
	vec3 normalCross = cross(edge1, edge2);
	// A degenerate triangle has no plane; facing the ray is the only sensible
	// orientation for the rare hit on one.
	vec3 geometricNormal = dot(normalCross, normalCross) > 1e-24
		? normalize(normalCross)
		: -normalize(objectRayDirection);

	// The normal matrix preserves the sign of a dot product with a transformed
	// direction, so facing can be decided in object space.
	frontFace = dot(objectRayDirection, geometricNormal) < 0.0;

	vec3 objectNormal = geometricNormal;
	float barycentricW = 1.0 - barycentrics.x - barycentrics.y;
	if (triangle.Normal0.w > 0.5)
	{
		vec3 interpolatedNormal =
			triangle.Normal0.xyz * barycentricW +
			triangle.Normal1.xyz * barycentrics.x +
			triangle.Normal2.xyz * barycentrics.y;
		if (dot(interpolatedNormal, interpolatedNormal) > 1e-12)
		{
			objectNormal = normalize(interpolatedNormal);
			// Imported normals may use the opposite winding convention. Keep the
			// shading normal in the geometric normal's hemisphere.
			if (dot(objectNormal, geometricNormal) < 0.0)
				objectNormal = -objectNormal;
		}
	}

	// Normals transform with the inverse transpose of the model matrix, which is
	// the transpose of the world to object matrix already at hand.
	shadingNormal = normalize(
		transpose(mat3(u_Model.WorldToObject)) * objectNormal);
	if (!frontFace)
		shadingNormal = -shadingNormal;

	textureTint = vec3(1.0);
	if (triangle.TexCoord2.w > 0.5)
	{
		vec2 texCoord =
			triangle.TexCoord01.xy * barycentricW +
			triangle.TexCoord01.zw * barycentrics.x +
			triangle.TexCoord2.xy * barycentrics.y;
		if (triangle.TexCoord2.z > 0.5)
		{
			// stb_image's row zero is the top of the image while OBJ convention
			// normally treats V=0 as the bottom, so V is flipped at sampling time.
			// Compute shaders have no implicit derivatives, so the level is
			// explicit; the images carry a single mip level anyway.
			vec3 encodedColor = textureLod(
				u_ModelTexture,
				vec2(texCoord.x, 1.0 - texCoord.y),
				0.0).rgb;
			textureTint = pow(encodedColor, vec3(2.2));
		}
		else
		{
			ivec2 checkerCell = ivec2(floor(texCoord * 8.0));
			bool lightCell = ((checkerCell.x + checkerCell.y) & 1) == 0;
			textureTint = lightCell ? vec3(1.0) : vec3(0.18);
		}
	}
}

bool TraceScene(Ray ray, out HitRecord closestHit)
{
	SceneHit hit;
	hit.Distance = NO_HIT;
	hit.Kind = HIT_NONE;
	hit.Index = 0u;
	hit.Barycentrics = vec2(0.0);
	TraceSpheres(ray, false, hit);
	TraceTriangles(ray, false, hit);

	closestHit.Distance = hit.Distance;
	if (hit.Kind == HIT_NONE)
		return false;

	closestHit.Position = ray.Origin + ray.Direction * hit.Distance;
	if (hit.Kind == HIT_SPHERE)
	{
		SphereData sphere = u_SphereBuffer.Spheres[hit.Index];
		vec3 outwardNormal = normalize(
			closestHit.Position - sphere.CenterRadius.xyz);
		closestHit.FrontFace = dot(ray.Direction, outwardNormal) < 0.0;
		closestHit.Normal = closestHit.FrontFace ? outwardNormal : -outwardNormal;
		closestHit.SurfaceMaterial = UnpackMaterial(
			sphere.AlbedoReflectivity,
			sphere.RoughnessMaterial);
		return true;
	}

	TriangleData triangle = u_TriangleBuffer.Triangles[hit.Index];
	vec3 textureTint;
	EvaluateTriangleSurface(
		triangle,
		hit.Barycentrics,
		mat3(u_Model.WorldToObject) * ray.Direction,
		closestHit.Normal,
		closestHit.FrontFace,
		textureTint);
	closestHit.SurfaceMaterial = UnpackMaterial(
		triangle.AlbedoReflectivity,
		triangle.RoughnessMaterial);
	closestHit.SurfaceMaterial.Albedo *= textureTint;
	return true;
}

SphereLight GetSphereLight(uint lightIndex)
{
	SphereLightData data = u_LightBuffer.Lights[lightIndex];

	SphereLight light;
	light.Position = data.PositionIntensity.xyz;
	light.Intensity = data.PositionIntensity.w;
	light.Color = data.Color.xyz;
	light.Radius = data.RadiusSampling.x;
	return light;
}

// Whether anything lies between the surface and a point maximumDistance away.
// Emitters count as blockers too, except the one being sampled: a BSDF ray in
// the same direction would stop at the first emitter it meets, and light
// sampling has to agree with that for the two strategies to combine correctly.
bool IsOccluded(
	vec3 surfacePosition,
	vec3 surfaceNormal,
	vec3 directionToLight,
	float maximumDistance,
	uint sampledLight)
{
	Ray shadowRay;
	shadowRay.Origin = surfacePosition + surfaceNormal * RAY_EPSILON;
	shadowRay.Direction = directionToLight;

	SceneHit hit;
	hit.Distance = maximumDistance - RAY_EPSILON;
	hit.Kind = HIT_NONE;
	if (TraceSpheres(shadowRay, true, hit) ||
		TraceTriangles(shadowRay, true, hit))
	{
		return true;
	}

	for (uint lightIndex = 0u;
		lightIndex < u_PushConstants.LightCount;
		lightIndex++)
	{
		if (lightIndex == sampledLight)
			continue;

		SphereLight light = GetSphereLight(lightIndex);
		float distance = HitSphereGeometry(shadowRay, light.Position, light.Radius);
		if (distance > 0.0 && distance < hit.Distance)
			return true;
	}

	return false;
}

// Light spheres are not part of the material BVH: there are at most eight, so
// a short linear scan is cheaper and keeps emitters separate from scene objects.
// maximumDistance makes a normal surface hide a light that lies behind it.
bool TraceSphereLights(
	Ray ray,
	float maximumDistance,
	out vec3 emission,
	out uint hitLightIndex)
{
	uint lightCount = u_PushConstants.LightCount;
	float closestDistance = maximumDistance;
	bool hitAnything = false;
	emission = vec3(0.0);
	hitLightIndex = lightCount;

	for (uint lightIndex = 0u; lightIndex < lightCount; lightIndex++)
	{
		SphereLight light = GetSphereLight(lightIndex);
		float hitDistance = HitSphereGeometry(
			ray,
			light.Position,
			light.Radius);

		if (hitDistance > 0.0 && hitDistance < closestDistance)
		{
			closestDistance = hitDistance;
			emission = light.Color * light.Intensity;
			hitLightIndex = lightIndex;
			hitAnything = true;
		}
	}

	return hitAnything;
}

// ---------------------------------------------------------------- lighting

float PowerHeuristic(float firstPdf, float secondPdf)
{
	float firstSquared = firstPdf * firstPdf;
	float secondSquared = secondPdf * secondPdf;
	float denominator = firstSquared + secondSquared;
	return denominator > 0.0 ? firstSquared / denominator : 0.0;
}

// sin^2/(1+cos) equals 1-cos but avoids losing the small difference between two
// nearly equal floats for a tiny, distant light.
float SphereLightSolidAngle(float sinThetaMaxSquared, float cosThetaMax)
{
	return 2.0 * PI * sinThetaMaxSquared / (1.0 + cosThetaMax);
}

float SphereLightDirectionPdf(vec3 surfacePosition, SphereLight light)
{
	vec3 surfaceToCenter = light.Position - surfacePosition;
	float centerDistanceSquared = dot(surfaceToCenter, surfaceToCenter);
	float radiusSquared = light.Radius * light.Radius;
	if (centerDistanceSquared <= radiusSquared)
		return 1.0 / (4.0 * PI);

	float sinThetaMaxSquared = radiusSquared / centerDistanceSquared;
	float cosThetaMax = sqrt(max(0.0, 1.0 - sinThetaMaxSquared));
	float solidAngle = SphereLightSolidAngle(sinThetaMaxSquared, cosThetaMax);
	return solidAngle > 0.0 ? 1.0 / solidAngle : 0.0;
}

// Picks one light in proportion to the slice of the total weight it was given on
// the CPU, and reports the probability of that pick so the caller can divide the
// contribution by it. Returns false only when no light carries any weight, which
// means every one of them would have contributed exactly zero.
bool SelectSphereLight(
	inout uint randomState,
	out uint selectedLight,
	out float selectionProbability)
{
	uint lightCount = u_PushConstants.LightCount;
	float random = NextRandom(randomState);

	selectedLight = lightCount;
	selectionProbability = 0.0;

	for (uint lightIndex = 0u; lightIndex < lightCount; lightIndex++)
	{
		float probability = u_LightBuffer.Lights[lightIndex].RadiusSampling.w;

		// A zero slice belongs to a light that cannot contribute at all.
		if (probability <= 0.0)
			continue;

		selectedLight = lightIndex;
		selectionProbability = probability;

		if (random < u_LightBuffer.Lights[lightIndex].RadiusSampling.z)
			return true;
	}

	return selectedLight < lightCount;
}

// Spends one shadow ray on a random point of one light and returns the direct
// contribution of that light alone. Both the all-lights loop and the stochastic
// single-light path call this, so they differ only in how many times it runs and
// how the result is weighted.
vec3 SampleSphereLight(
	uint lightIndex,
	HitRecord hit,
	vec3 viewDirection,
	inout uint randomState,
	float lightSelectionProbability)
{
	SphereLight light = GetSphereLight(lightIndex);
	vec3 surfaceToCenter = light.Position - hit.Position;
	float centerDistanceSquared = dot(surfaceToCenter, surfaceToCenter);
	float radiusSquared = light.Radius * light.Radius;

	vec3 directionToLight;
	float lightDirectionPdf;
	if (centerDistanceSquared <= radiusSquared)
	{
		// An overlapping emitter surrounds the shading point and covers the full
		// sphere of directions. Treat it as two-sided for this edge case.
		directionToLight = RandomUnitVector(randomState);
		lightDirectionPdf = 1.0 / (4.0 * PI);
	}
	else
	{
		vec3 directionToCenter =
			surfaceToCenter / sqrt(centerDistanceSquared);
		float sinThetaMaxSquared =
			radiusSquared / centerDistanceSquared;
		float cosThetaMax = sqrt(max(0.0, 1.0 - sinThetaMaxSquared));
		float cosTheta = mix(1.0, cosThetaMax, NextRandom(randomState));
		float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
		float angle = 2.0 * PI * NextRandom(randomState);
		vec3 localDirection = vec3(
			cos(angle) * sinTheta,
			sin(angle) * sinTheta,
			cosTheta);

		directionToLight = LocalToWorld(localDirection, directionToCenter);
		lightDirectionPdf =
			1.0 / SphereLightSolidAngle(sinThetaMaxSquared, cosThetaMax);
	}

	float surfaceCosine = max(dot(hit.Normal, directionToLight), 0.0);
	float lightTechniquePdf = lightSelectionProbability * lightDirectionPdf;
	if (surfaceCosine <= 0.0 || lightTechniquePdf <= 0.0)
		return vec3(0.0);

	Ray lightRay;
	lightRay.Origin = hit.Position;
	lightRay.Direction = directionToLight;
	float lightDistance = HitSphereGeometry(
		lightRay,
		light.Position,
		light.Radius);
	if (lightDistance <= 0.0 ||
		IsOccluded(
			hit.Position,
			hit.Normal,
			directionToLight,
			lightDistance,
			lightIndex))
	{
		return vec3(0.0);
	}

	vec3 brdf = EvaluateSurfaceBrdf(
		hit.SurfaceMaterial,
		hit.Normal,
		viewDirection,
		directionToLight);
	float bsdfPdf = SurfaceDirectionPdf(
		hit.SurfaceMaterial,
		hit.Normal,
		viewDirection,
		directionToLight);
	float misWeight = PowerHeuristic(lightTechniquePdf, bsdfPdf);
	return brdf * light.Color * light.Intensity * surfaceCosine /
		lightTechniquePdf * misWeight;
}

// The same formula as EnvironmentTexelSolidAngle on the CPU: the polar band a
// row covers, written as a product of sines so thin polar rows stay accurate.
float EnvironmentTexelSolidAngle(uint row)
{
	float width = float(u_PushConstants.EnvironmentWidth);
	float height = float(u_PushConstants.EnvironmentHeight);
	float halfRowAngle = PI / (2.0 * height);
	float rowCenterAngle = PI * (2.0 * float(row) + 1.0) / (2.0 * height);
	return 2.0 * PI / width * 2.0 * sin(rowCenterAngle) * sin(halfRowAngle);
}

// Equirectangular mapping: u follows the longitude around +Y and v the polar
// angle measured down from +Y, so v = 0 is straight up.
vec2 DirectionToEnvironmentUv(vec3 direction)
{
	float longitude = atan(direction.z, direction.x) +
		u_PushConstants.EnvironmentRotation;
	float polarAngle = acos(clamp(direction.y, -1.0, 1.0));
	return vec2(fract(longitude / (2.0 * PI) + 0.5), polarAngle / PI);
}

vec3 GetSkyColor(vec3 rayDirection)
{
	if (HasFlag(RENDER_FLAG_ENVIRONMENT_MAP))
	{
		return textureLod(
			u_EnvironmentTexture,
			DirectionToEnvironmentUv(rayDirection),
			0.0).rgb *
			u_PushConstants.EnvironmentIntensity;
	}

	float skyBlend = 0.5 * (rayDirection.y + 1.0);
	vec3 horizonColor = vec3(1.0);
	vec3 skyColor = vec3(0.5, 0.7, 1.0);
	return mix(horizonColor, skyColor, skyBlend) *
		u_PushConstants.EnvironmentIntensity;
}

float EnvironmentDirectionPdf(vec3 direction)
{
	uint width = u_PushConstants.EnvironmentWidth;
	uint height = u_PushConstants.EnvironmentHeight;
	if (!HasFlag(RENDER_FLAG_ENVIRONMENT_MAP) || width == 0u || height == 0u)
		return 0.0;

	// Clamping both axes keeps a coordinate that rounds to exactly one from
	// reading past the distribution buffer.
	uvec2 texel = min(
		uvec2(DirectionToEnvironmentUv(direction) * vec2(width, height)),
		uvec2(width - 1u, height - 1u));
	float mass = u_EnvironmentDistribution.Entries[texel.y * width + texel.x].y;
	return mass / EnvironmentTexelSolidAngle(texel.y);
}

// Picks a texel in proportion to its luminance times solid angle, then a
// direction uniformly by solid angle inside it, so the density is exactly the
// texel's probability over its solid angle, which EnvironmentDirectionPdf returns.
vec3 SampleEnvironmentLight(HitRecord hit, Material material, inout uint randomState)
{
	uint width = u_PushConstants.EnvironmentWidth;
	uint height = u_PushConstants.EnvironmentHeight;
	uint count = width * height;
	if (!HasFlag(RENDER_FLAG_ENVIRONMENT_MAP) || count == 0u)
		return vec3(0.0);

	float target = NextRandom(randomState);
	uint lower = 0u;
	uint upper = count - 1u;
	while (lower < upper)
	{
		uint middle = lower + (upper - lower) / 2u;
		if (u_EnvironmentDistribution.Entries[middle].x <= target)
			lower = middle + 1u;
		else
			upper = middle;
	}

	uvec2 texel = uvec2(lower % width, lower / width);
	float u = (float(texel.x) + NextRandom(randomState)) / float(width);
	float topCosine = cos(PI * float(texel.y) / float(height));
	float bottomCosine = cos(PI * float(texel.y + 1u) / float(height));
	float cosPolar = mix(topCosine, bottomCosine, NextRandom(randomState));
	float sinPolar = sqrt(max(0.0, 1.0 - cosPolar * cosPolar));
	float longitude = (u - 0.5) * 2.0 * PI - u_PushConstants.EnvironmentRotation;
	vec3 direction = vec3(
		sinPolar * cos(longitude),
		cosPolar,
		sinPolar * sin(longitude));

	float cosine = max(dot(hit.Normal, direction), 0.0);
	float texelProbability = u_EnvironmentDistribution.Entries[lower].y;
	float environmentPdf = texelProbability / EnvironmentTexelSolidAngle(texel.y);
	if (cosine <= 0.0 || environmentPdf <= 0.0 ||
		IsOccluded(
			hit.Position,
			hit.Normal,
			direction,
			NO_HIT,
			u_PushConstants.LightCount))
	{
		return vec3(0.0);
	}

	float weight = PowerHeuristic(environmentPdf, LambertPdf(hit.Normal, direction));
	return EvaluateLambertBrdf(material) * GetSkyColor(direction) *
		cosine * weight / environmentPdf;
}

vec3 ToneMapAces(vec3 hdrColor)
{
	// This compact ACES filmic fit keeps bright HDR highlights from turning into
	// flat white as abruptly as a simple channel-by-channel compression.
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp(
		(hdrColor * (a * hdrColor + b)) /
		(hdrColor * (c * hdrColor + d) + e),
		vec3(0.0),
		vec3(1.0));
}

vec3 LinearToSrgb(vec3 linearColor)
{
	vec3 safeColor = max(linearColor, vec3(0.0));
	vec3 lowRange = 12.92 * safeColor;
	vec3 highRange =
		1.055 * pow(safeColor, vec3(1.0 / 2.4)) - 0.055;
	return mix(
		highRange,
		lowRange,
		lessThanEqual(safeColor, vec3(0.0031308)));
}

// ------------------------------------------------------------- path tracing

vec3 TraceRay(Ray initialRay, uint randomSeed)
{
	Ray ray = initialRay;
	vec3 accumulatedColor = vec3(0.0);
	vec3 throughput = vec3(1.0);
	uint randomState = randomSeed;
	uint lightCount = u_PushConstants.LightCount;
	bool sampleOneLight = HasFlag(RENDER_FLAG_STOCHASTIC_LIGHTS);
	bool previousBounceUsedDirectLighting = false;
	bool previousBounceSampledEnvironment = false;
	vec3 previousSurfacePosition = vec3(0.0);
	float previousBsdfPdf = 0.0;

	for (
		uint bounceIndex = 0u;
		bounceIndex < u_PushConstants.BounceCount;
		bounceIndex++)
	{
		// After three guaranteed segments, a weak path survives in proportion to
		// its strongest colour channel. Dividing survivors by that same probability
		// exactly compensates for the paths that stop, preserving the mean result.
		if (bounceIndex >= RUSSIAN_ROULETTE_START_BOUNCE)
		{
			float strongestThroughputChannel = max(
				throughput.r,
				max(throughput.g, throughput.b));
			float survivalProbability = clamp(
				strongestThroughputChannel,
				MIN_PATH_SURVIVAL_PROBABILITY,
				MAX_PATH_SURVIVAL_PROBABILITY);

			if (NextRandom(randomState) >= survivalProbability)
				break;

			throughput /= survivalProbability;
		}

		HitRecord closestHit;
		bool hitSurface = TraceScene(ray, closestHit);
		vec3 lightEmission;
		uint hitLightIndex;

		// A directly visible emitter, or one reached by a reflection/refraction,
		// contributes its own emitted radiance instead of behaving like a material.
		if (TraceSphereLights(
			ray,
			closestHit.Distance,
			lightEmission,
			hitLightIndex))
		{
			float emitterWeight = 1.0;
			if (previousBounceUsedDirectLighting)
			{
				SphereLight hitLight = GetSphereLight(hitLightIndex);
				float lightSelectionProbability = sampleOneLight
					? u_LightBuffer.Lights[hitLightIndex].RadiusSampling.w
					: 1.0;
				float lightTechniquePdf =
					lightSelectionProbability *
					SphereLightDirectionPdf(previousSurfacePosition, hitLight);
				emitterWeight = PowerHeuristic(previousBsdfPdf, lightTechniquePdf);
			}

			accumulatedColor += throughput * lightEmission * emitterWeight;
			break;
		}

		if (!hitSurface)
		{
			float environmentWeight = previousBounceSampledEnvironment
				? PowerHeuristic(previousBsdfPdf, EnvironmentDirectionPdf(ray.Direction))
				: 1.0;
			accumulatedColor += throughput * GetSkyColor(ray.Direction) * environmentWeight;
			break;
		}

		Material material = closestHit.SurfaceMaterial;
		bool usesDirectLighting =
			material.Type == MATERIAL_LEGACY ||
			material.Type == MATERIAL_DIFFUSE ||
			material.Type == MATERIAL_METAL;
		vec3 surfaceColor = vec3(0.0);
		vec3 viewDirection = normalize(-ray.Direction);

		if (usesDirectLighting)
		{
			if (sampleOneLight && lightCount > 0u)
			{
				// One chosen light stands in for the whole list, so the shadow ray
				// cost per bounce no longer grows with light count. Dividing by the
				// probability keeps the expected value equal to the full light sum.
				uint lightIndex;
				float selectionProbability;
				if (SelectSphereLight(randomState, lightIndex, selectionProbability))
				{
					surfaceColor += SampleSphereLight(
						lightIndex,
						closestHit,
						viewDirection,
						randomState,
						selectionProbability);
				}
			}
			else
			{
				// Every light is sampled independently and its contribution is
				// summed, so light count multiplies the shadow ray cost per bounce.
				for (uint lightIndex = 0u; lightIndex < lightCount; lightIndex++)
				{
					surfaceColor += SampleSphereLight(
						lightIndex,
						closestHit,
						viewDirection,
						randomState,
						1.0);
				}
			}
		}

		if (material.Type == MATERIAL_DIFFUSE)
		{
			surfaceColor += SampleEnvironmentLight(closestHit, material, randomState);
			// Direct light is one part of the answer. The new cosine-weighted ray
			// carries the other part: light arriving after one or more surface bounces.
			accumulatedColor += throughput * surfaceColor;
			ray.Origin = closestHit.Position + closestHit.Normal * RAY_EPSILON;
			ray.Direction = RandomCosineHemisphere(closestHit.Normal, randomState);
			float surfaceCosine = max(dot(closestHit.Normal, ray.Direction), 0.0);
			float directionPdf = LambertPdf(closestHit.Normal, ray.Direction);
			if (directionPdf <= 0.0)
				break;
			throughput *= EvaluateLambertBrdf(material) * surfaceCosine / directionPdf;
			previousBounceUsedDirectLighting = true;
			previousBounceSampledEnvironment = HasFlag(RENDER_FLAG_ENVIRONMENT_MAP);
			previousSurfacePosition = closestHit.Position;
			previousBsdfPdf = directionPdf;
			continue;
		}

		if (material.Type == MATERIAL_DIELECTRIC)
		{
			// A back-face hit means this segment travelled through the glass. Albedo
			// is interpreted as transmittance per world unit, so Beer-Lambert
			// absorption naturally makes a longer trip lose more coloured energy.
			if (!closestHit.FrontFace)
			{
				vec3 transmittancePerUnit = clamp(
					material.Albedo,
					vec3(0.001),
					vec3(1.0));
				throughput *= pow(transmittancePerUnit, vec3(closestHit.Distance));
			}

			// Entering glass goes from air (1.0) to the material IOR; leaving it
			// reverses that ratio. The oriented normal always opposes the ray.
			float refractionRatio = closestHit.FrontFace
				? 1.0 / material.IndexOfRefraction
				: material.IndexOfRefraction;
			vec3 unitDirection = normalize(ray.Direction);
			float cosTheta = min(dot(-unitDirection, closestHit.Normal), 1.0);

			// Schlick has to be evaluated on the air side of the interface, which
			// is the transmitted angle when the ray is leaving the glass.
			float schlickCosTheta = cosTheta;
			bool cannotRefract = false;
			float sinThetaTSquared =
				refractionRatio * refractionRatio * (1.0 - cosTheta * cosTheta);
			if (sinThetaTSquared >= 1.0)
				cannotRefract = true;
			else if (!closestHit.FrontFace)
				schlickCosTheta = sqrt(1.0 - sinThetaTSquared);

			// When Snell's law has no real solution, all energy must reflect. In
			// every other case Schlick chooses between reflection and refraction.
			bool shouldReflect =
				cannotRefract ||
				SchlickReflectance(schlickCosTheta, material.IndexOfRefraction) >
					NextRandom(randomState);

			ray.Direction = shouldReflect
				? normalize(reflect(unitDirection, closestHit.Normal))
				: normalize(refract(unitDirection, closestHit.Normal, refractionRatio));
			// Offsetting along the new direction puts an entering ray inside and an
			// exiting ray outside without assuming which side reflection chose.
			ray.Origin = closestHit.Position + ray.Direction * RAY_EPSILON;
			previousBounceUsedDirectLighting = false;
			previousBounceSampledEnvironment = false;
			continue;
		}

		float reflectivity = material.Reflectivity;
		if (material.Type == MATERIAL_LEGACY)
		{
			// Old scene files keep the original hybrid model exactly: part of the
			// energy uses diffuse lighting and the rest continues as a reflection.
			accumulatedColor += throughput * surfaceColor * (1.0 - reflectivity);
		}

		if (reflectivity <= 0.0)
			break;

		if (material.Type == MATERIAL_METAL)
		{
			accumulatedColor += throughput * surfaceColor;
			ray.Origin = closestHit.Position + closestHit.Normal * RAY_EPSILON;
			ray.Direction = SampleGgxReflection(
				material,
				closestHit.Normal,
				viewDirection,
				randomState);
			float surfaceCosine = max(dot(closestHit.Normal, ray.Direction), 0.0);
			float directionPdf = MetalReflectionPdf(
				material,
				closestHit.Normal,
				viewDirection,
				ray.Direction);
			if (surfaceCosine <= 0.0 || directionPdf <= 0.0)
				break;

			throughput *=
				EvaluateMetalBrdf(
					material,
					closestHit.Normal,
					viewDirection,
					ray.Direction) *
				surfaceCosine /
				directionPdf;
			previousBounceUsedDirectLighting = true;
			previousBounceSampledEnvironment = false;
			previousSurfacePosition = closestHit.Position;
			previousBsdfPdf = directionPdf;
			continue;
		}

		// Legacy keeps the original tinted reflection model for old scene files.
		throughput *= material.Albedo * reflectivity;
		ray.Origin = closestHit.Position + closestHit.Normal * RAY_EPSILON;

		vec3 perfectReflection = normalize(reflect(ray.Direction, closestHit.Normal));
		vec3 randomDirection = RandomUnitVector(randomState);
		if (dot(randomDirection, closestHit.Normal) < 0.0)
			randomDirection = -randomDirection;

		ray.Direction = normalize(mix(
			perfectReflection,
			randomDirection,
			material.Roughness));
		previousBounceUsedDirectLighting = false;
		previousBounceSampledEnvironment = false;
	}

	return accumulatedColor;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 imageSize = imageSize(u_OutputImage);

	if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
		return;

	// Hashing the frame index before mixing it in keeps neighbouring pixels in
	// neighbouring frames from starting on related random sequences.
	uint pixelSeed = uint(pixel.x) + uint(pixel.y) * uint(imageSize.x);
	uint frameSeed = Hash(pixelSeed ^ Hash(u_PushConstants.FrameIndex));
	vec2 pixelJitter = vec2(
		RandomFloat(frameSeed),
		RandomFloat(frameSeed ^ 0x68bc21ebu)) - 0.5;

	vec2 uv = (vec2(pixel) + vec2(0.5) + pixelJitter) / vec2(imageSize);
	vec2 screenPosition = uv * 2.0 - 1.0;
	// Image rows grow downwards while world up is +Y, so this is the single
	// place the two conventions are reconciled: row 0 becomes the top of the
	// scene. The display path must not flip the image again.
	screenPosition.y = -screenPosition.y;

	float aspectRatio = float(imageSize.x) / float(imageSize.y);
	float fieldOfViewScale = tan(radians(u_PushConstants.VerticalFov) * 0.5);

	vec3 cameraForward = normalize(u_PushConstants.CameraForward.xyz);
	vec3 worldUp = vec3(0.0, 1.0, 0.0);
	if (abs(dot(cameraForward, worldUp)) > 0.999)
		worldUp = vec3(0.0, 0.0, 1.0);
	vec3 cameraRight = normalize(cross(cameraForward, worldUp));
	vec3 cameraUp = normalize(cross(cameraRight, cameraForward));

	Ray ray;
	ray.Origin = u_PushConstants.CameraPosition.xyz;
	ray.Direction = normalize(
		cameraForward +
		cameraRight * screenPosition.x * aspectRatio * fieldOfViewScale +
		cameraUp * screenPosition.y * fieldOfViewScale);

	vec3 sampleColor = TraceRay(ray, frameSeed ^ 0xa511e9b3u);
	// One invalid floating-point path must not poison this pixel forever because
	// every later frame reads the previous accumulation before adding its sample.
	if (any(isnan(sampleColor)) || any(isinf(sampleColor)))
		sampleColor = vec3(0.0);
	else
		sampleColor = max(sampleColor, vec3(0.0));

	vec3 previousAccumulation = u_PushConstants.FrameIndex > 1u
		? imageLoad(u_AccumulationImage, pixel).rgb
		: vec3(0.0);
	vec3 accumulatedColor = previousAccumulation + sampleColor;
	imageStore(u_AccumulationImage, pixel, vec4(accumulatedColor, 1.0));

	vec3 averageColor = accumulatedColor / float(u_PushConstants.FrameIndex);
	vec3 displayColor = LinearToSrgb(ToneMapAces(averageColor * u_PushConstants.Exposure));
	imageStore(u_OutputImage, pixel, vec4(displayColor, 1.0));
}
