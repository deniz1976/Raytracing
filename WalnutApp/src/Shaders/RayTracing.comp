#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D u_OutputImage;

const int SPHERE_COUNT = 4;
const int MAX_BOUNCES = 3;
const float RAY_EPSILON = 0.001;

struct Ray
{
	vec3 Origin;
	vec3 Direction;
};

struct Material
{
	vec3 Albedo;
	float Reflectivity;
};

struct Sphere
{
	vec3 Center;
	float Radius;
	Material SurfaceMaterial;
};

struct DirectionalLight
{
	vec3 Direction;
	vec3 Color;
	float Intensity;
};

struct HitRecord
{
	float Distance;
	vec3 Position;
	vec3 Normal;
	Material SurfaceMaterial;
};

float HitSphere(Ray ray, Sphere sphere)
{
	vec3 originToCenter = ray.Origin - sphere.Center;

	float a = dot(ray.Direction, ray.Direction);
	float b = 2.0 * dot(originToCenter, ray.Direction);
	float c = dot(originToCenter, originToCenter) - sphere.Radius * sphere.Radius;

	float discriminant = b * b - 4.0 * a * c;
	if (discriminant < 0.0)
		return -1.0;

	float squareRoot = sqrt(discriminant);
	float nearestDistance = (-b - squareRoot) / (2.0 * a);
	if (nearestDistance > RAY_EPSILON)
		return nearestDistance;

	float farthestDistance = (-b + squareRoot) / (2.0 * a);
	if (farthestDistance > RAY_EPSILON)
		return farthestDistance;

	return -1.0;
}

bool TraceScene(
	Ray ray,
	Sphere spheres[SPHERE_COUNT],
	out HitRecord closestHit)
{
	bool hitAnything = false;
	closestHit.Distance = 1e30;

	for (int sphereIndex = 0; sphereIndex < SPHERE_COUNT; sphereIndex++)
	{
		Sphere sphere = spheres[sphereIndex];
		float hitDistance = HitSphere(ray, sphere);

		if (hitDistance > 0.0 && hitDistance < closestHit.Distance)
		{
			hitAnything = true;
			closestHit.Distance = hitDistance;
			closestHit.Position = ray.Origin + ray.Direction * hitDistance;
			closestHit.Normal = normalize(closestHit.Position - sphere.Center);
			closestHit.SurfaceMaterial = sphere.SurfaceMaterial;
		}
	}

	return hitAnything;
}

bool IsOccluded(
	vec3 surfacePosition,
	vec3 surfaceNormal,
	vec3 directionToLight,
	Sphere spheres[SPHERE_COUNT])
{
	Ray shadowRay;
	shadowRay.Origin = surfacePosition + surfaceNormal * RAY_EPSILON;
	shadowRay.Direction = directionToLight;

	for (int sphereIndex = 0; sphereIndex < SPHERE_COUNT; sphereIndex++)
	{
		if (HitSphere(shadowRay, spheres[sphereIndex]) > 0.0)
			return true;
	}

	return false;
}

vec3 CalculateDirectionalLight(
	DirectionalLight light,
	Material material,
	vec3 surfaceNormal,
	float lightVisibility)
{
	vec3 directionToLight = normalize(-light.Direction);
	float diffuseStrength =
		max(dot(surfaceNormal, directionToLight), 0.0) *
		lightVisibility;

	vec3 ambientColor = material.Albedo * 0.08;
	vec3 diffuseColor =
		material.Albedo *
		light.Color *
		diffuseStrength *
		light.Intensity;

	return ambientColor + diffuseColor;
}

vec3 GetSkyColor(vec3 rayDirection)
{
	float skyBlend = 0.5 * (rayDirection.y + 1.0);
	vec3 horizonColor = vec3(1.0);
	vec3 skyColor = vec3(0.5, 0.7, 1.0);
	return mix(horizonColor, skyColor, skyBlend);
}

vec3 TraceRay(
	Ray initialRay,
	Sphere spheres[SPHERE_COUNT],
	DirectionalLight sun)
{
	Ray ray = initialRay;
	vec3 accumulatedColor = vec3(0.0);
	vec3 throughput = vec3(1.0);

	for (int bounceIndex = 0; bounceIndex < MAX_BOUNCES; bounceIndex++)
	{
		HitRecord closestHit;

		if (!TraceScene(ray, spheres, closestHit))
		{
			accumulatedColor += throughput * GetSkyColor(ray.Direction);
			break;
		}

		vec3 directionToLight = normalize(-sun.Direction);
		bool isInShadow = IsOccluded(
			closestHit.Position,
			closestHit.Normal,
			directionToLight,
			spheres);

		float lightVisibility = isInShadow ? 0.0 : 1.0;
		vec3 surfaceColor = CalculateDirectionalLight(
			sun,
			closestHit.SurfaceMaterial,
			closestHit.Normal,
			lightVisibility);

		float reflectivity = closestHit.SurfaceMaterial.Reflectivity;
		accumulatedColor +=
			throughput *
			surfaceColor *
			(1.0 - reflectivity);

		if (reflectivity <= 0.0)
			break;

		throughput *=
			closestHit.SurfaceMaterial.Albedo *
			reflectivity;

		ray.Origin =
			closestHit.Position +
			closestHit.Normal * RAY_EPSILON;
		ray.Direction = normalize(reflect(
			ray.Direction,
			closestHit.Normal));
	}

	return accumulatedColor;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 imageSize = imageSize(u_OutputImage);

	if (pixel.x >= imageSize.x || pixel.y >= imageSize.y)
		return;

	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(imageSize);
	vec2 screenPosition = uv * 2.0 - 1.0;
	screenPosition.y = -screenPosition.y;

	float aspectRatio = float(imageSize.x) / float(imageSize.y);
	float fieldOfView = radians(45.0);
	float fieldOfViewScale = tan(fieldOfView * 0.5);

	Ray ray;
	ray.Origin = vec3(0.0, 0.0, 3.0);
	ray.Direction = normalize(vec3(
		screenPosition.x * aspectRatio * fieldOfViewScale,
		screenPosition.y * fieldOfViewScale,
		-1.0));

	Sphere spheres[SPHERE_COUNT];

	spheres[0].Center = vec3(0.0, 0.0, 0.0);
	spheres[0].Radius = 1.0;
	spheres[0].SurfaceMaterial.Albedo = vec3(0.85, 0.18, 0.12);
	spheres[0].SurfaceMaterial.Reflectivity = 0.15;

	spheres[1].Center = vec3(-2.1, 0.0, -1.0);
	spheres[1].Radius = 1.0;
	spheres[1].SurfaceMaterial.Albedo = vec3(0.12, 0.35, 0.85);
	spheres[1].SurfaceMaterial.Reflectivity = 0.75;

	spheres[2].Center = vec3(2.1, 0.0, -1.0);
	spheres[2].Radius = 1.0;
	spheres[2].SurfaceMaterial.Albedo = vec3(0.15, 0.75, 0.28);
	spheres[2].SurfaceMaterial.Reflectivity = 0.35;

	spheres[3].Center = vec3(0.0, -101.0, 0.0);
	spheres[3].Radius = 100.0;
	spheres[3].SurfaceMaterial.Albedo = vec3(0.55, 0.55, 0.55);
	spheres[3].SurfaceMaterial.Reflectivity = 0.15;

	DirectionalLight sun;
	sun.Direction = normalize(vec3(-1.0, -1.0, -1.0));
	sun.Color = vec3(1.0, 0.95, 0.85);
	sun.Intensity = 1.0;

	vec3 color = TraceRay(ray, spheres, sun);
	imageStore(u_OutputImage, pixel, vec4(color, 1.0));
}
